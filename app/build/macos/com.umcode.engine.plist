<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The engine, registered as a login-item agent with SMAppService. It lives in
  UMCode.app/Contents/Library/LaunchAgents, so launchd runs the binary from
  inside the bundle and the app can register and unregister it at runtime.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.umcode.engine</string>
    <key>BundleProgram</key>
    <string>Contents/Resources/umcode</string>
    <key>ProgramArguments</key>
    <array>
        <string>Contents/Resources/umcode</string>
        <string>engine</string>
    </array>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.umcode.app</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd's PATH is minimal; skills and MCP servers expect Homebrew. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
